---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config/site.config';
import ReviveSlot from '../components/ads/ReviveSlot.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft && (!data.lang || data.lang === 'fr'));
allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Lead article (road trip ou circuit phare)
const leadPost = allPosts.find(p => p.id.includes('road-trip') || p.id.includes('itineraire') || p.id.includes('sejour-type')) || allPosts[0];
const remainingPosts = allPosts.filter(p => p.id !== leadPost?.id);

// Circuits & Itinéraires thématiques
const roadTrips = allPosts.filter(p => 
  p.data.category === 'Circuit & Road Trip' || 
  p.id.includes('road-trip') || 
  p.id.includes('sejour-type')
).slice(0, 4);

// Découvertes Terroir & Rhum / Excursions
const excursions = allPosts.filter(p => 
  p.data.category === 'Rhum' || 
  p.data.category === 'Excursion' || 
  p.data.category === 'Commune'
).slice(0, 6);

// Dernières publications pour le journal de bord
const journalPosts = remainingPosts.slice(0, 8);
---

<Layout title="Carnet de Route & Guide de Voyage en Martinique" description="Circuits d'expédition, road trips en voiture, randonnées volcaniques de la Montagne Pelée et plages secrètes de Martinique.">
  <!-- En-tête Éditorial Carnet de Route -->
  <header class="border-b border-stone-200 bg-[#faf8f5] pt-10 pb-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-center justify-between gap-4 border-b border-stone-300 pb-4 mb-8 text-xs font-mono uppercase tracking-widest text-stone-500">
        <div class="flex items-center gap-3">
          <span class="inline-block w-2.5 h-2.5 rounded-full bg-amber-600 animate-pulse"></span>
          <span>Feuille de Route Martinique • Ép. 2025</span>
        </div>
        <div>Coord. GPS : 14°38'N 61°03'W</div>
        <div>200 Étapes & Récits Référencés</div>
      </div>

      <!-- Hero Split-Screen Roadbook (Style Carnet de Voyage Minimaliste) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start pt-2 pb-6">
        
        <!-- Colonne Principale Gauche (7 colonnes) : Récit Phare -->
        {leadPost && (
          <div class="lg:col-span-7 flex flex-col justify-between">
            <div>
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-amber-100 text-amber-900 text-xs font-semibold tracking-wider uppercase mb-4">
                <span>Étape Vedette</span>
                <span>•</span>
                <span>{leadPost.data.category}</span>
              </div>

              <h1 class="text-3xl sm:text-5xl font-serif font-bold text-stone-950 tracking-tight leading-[1.15] mb-6">
                <a href={`/blog/${leadPost.id}/`} class="hover:text-amber-800 transition-colors">
                  {leadPost.data.title}
                </a>
              </h1>

              <p class="text-base sm:text-lg text-stone-700 leading-relaxed font-normal mb-8 max-w-2xl">
                {leadPost.data.description}
              </p>
            </div>

            <div class="pt-6 border-t border-stone-300 flex flex-wrap items-center justify-between gap-4">
              <a href={`/blog/${leadPost.id}/`} class="inline-flex items-center gap-3 px-6 py-3 bg-stone-900 hover:bg-amber-800 text-white text-xs font-bold uppercase tracking-wider rounded transition-colors shadow-sm">
                Consulter l'Itinéraire Complet &rarr;
              </a>
              <div class="text-xs text-stone-500 font-mono">
                Mis à jour le {new Date(leadPost.data.pubDate).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}
              </div>
            </div>
          </div>
        )}

        <!-- Colonne Droite (5 colonnes) : L'Index des Étapes Incontournables -->
        <div class="lg:col-span-5 bg-white border border-stone-200 p-6 sm:p-8 rounded-xl shadow-sm">
          <div class="border-b border-stone-200 pb-3 mb-6 flex items-center justify-between">
            <h2 class="text-xs font-bold uppercase tracking-widest text-stone-900 font-mono">
              Index des Grandes Boucles
            </h2>
            <span class="text-xs text-amber-700 font-bold">04 Circuits</span>
          </div>

          <!-- Timeline / Étapes numérotées -->
          <div class="space-y-6">
            <div class="flex gap-4 items-start">
              <span class="w-7 h-7 rounded-full bg-amber-50 text-amber-900 border border-amber-300 font-mono text-xs flex items-center justify-center font-bold flex-shrink-0">
                01
              </span>
              <div>
                <h3 class="text-sm font-bold text-stone-900 hover:text-amber-800 transition-colors">
                  <a href="/blog/">Le Nord Volcanique & La Montagne Pelée</a>
                </h3>
                <p class="text-xs text-stone-600 mt-1 leading-snug">
                  De Saint-Pierre la ressuscitée à Grand-Rivière, traversez les gorges de la Falaise et les pentes volcaniques.
                </p>
              </div>
            </div>

            <div class="flex gap-4 items-start">
              <span class="w-7 h-7 rounded-full bg-amber-50 text-amber-900 border border-amber-300 font-mono text-xs flex items-center justify-center font-bold flex-shrink-0">
                02
              </span>
              <div>
                <h3 class="text-sm font-bold text-stone-900 hover:text-amber-800 transition-colors">
                  <a href="/blog/">Le Sud Caraïbes & Les Plages Sauvages</a>
                </h3>
                <p class="text-xs text-stone-600 mt-1 leading-snug">
                  Du rocher du Diamant aux anses d'Arlet et à la plage mythique des Salines de Sainte-Anne.
                </p>
              </div>
            </div>

            <div class="flex gap-4 items-start">
              <span class="w-7 h-7 rounded-full bg-amber-50 text-amber-900 border border-amber-300 font-mono text-xs flex items-center justify-center font-bold flex-shrink-0">
                03
              </span>
              <div>
                <h3 class="text-sm font-bold text-stone-900 hover:text-amber-800 transition-colors">
                  <a href="/blog/">La Presqu'île de la Caravelle & L'Atlantique</a>
                </h3>
                <p class="text-xs text-stone-600 mt-1 leading-snug">
                  Sentiers côtiers sculptés par les alizés, ruines du château Dubuc et villages de pêcheurs de Tartane.
                </p>
              </div>
            </div>

            <div class="flex gap-4 items-start">
              <span class="w-7 h-7 rounded-full bg-amber-50 text-amber-900 border border-amber-300 font-mono text-xs flex items-center justify-center font-bold flex-shrink-0">
                04
              </span>
              <div>
                <h3 class="text-sm font-bold text-stone-900 hover:text-amber-800 transition-colors">
                  <a href="/blog/">La Route du Rhum & Terroir Séculaire</a>
                </h3>
                <p class="text-xs text-stone-600 mt-1 leading-snug">
                  Habitations agricoles, distilleries AOC et secrets de fabrication du rhum agricole martiniquais.
                </p>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </header>

  <!-- Bannière Publicitaire Header (Revive) -->
  {siteConfig.revive?.zones?.header && (
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 my-8 flex justify-center">
      <ReviveSlot format={siteConfig.revive.zones.header.format} zoneId={siteConfig.revive.zones.header.zoneId} />
    </div>
  )}

  <!-- Section Road Trips par Durée (Format Carnet Horizontal) -->
  {roadTrips.length > 0 && (
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="flex flex-wrap items-end justify-between border-b-2 border-stone-900 pb-3 mb-8">
        <div>
          <span class="text-xs font-mono uppercase tracking-widest text-amber-800 font-bold">Sélection Circuits</span>
          <h2 class="text-2xl sm:text-3xl font-serif font-bold text-stone-950 mt-1">Feuilles de Route par Durée</h2>
        </div>
        <a href="/blog/" class="text-xs font-mono font-bold uppercase tracking-wider text-amber-800 hover:underline">
          Tous les séjours &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {roadTrips.map(post => (
          <article class="bg-[#faf8f5] border-l-4 border-amber-600 p-5 rounded-r shadow-sm hover:shadow transition-shadow flex flex-col justify-between">
            <div>
              <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-stone-500 mb-2 block">
                {post.data.category}
              </span>
              <h3 class="text-base font-serif font-bold text-stone-900 hover:text-amber-800 transition-colors leading-snug mb-3">
                <a href={`/blog/${post.id}/`}>
                  {post.data.title}
                </a>
              </h3>
              <p class="text-xs text-stone-600 line-clamp-3 leading-relaxed mb-4">
                {post.data.description}
              </p>
            </div>
            <div class="pt-3 border-t border-stone-200 flex items-center justify-between text-[11px] font-mono text-stone-500">
              <span>{new Date(post.data.pubDate).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' })}</span>
              <a href={`/blog/${post.id}/`} class="font-bold text-amber-800 hover:underline">Lire le guide &rarr;</a>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  <!-- Section Le Journal de Bord & Chroniques (Layout Magazine Journalistique) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="flex flex-wrap items-end justify-between border-b border-stone-300 pb-3 mb-8">
      <div>
        <span class="text-xs font-mono uppercase tracking-widest text-stone-500">Le Journal d'Expédition</span>
        <h2 class="text-2xl sm:text-3xl font-serif font-bold text-stone-950 mt-1">Dernières Étapes & Récits de l'Île</h2>
      </div>
      <a href="/blog/" class="text-xs font-mono font-bold uppercase tracking-wider text-stone-600 hover:text-amber-800">
        Consulter l'archive complète &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Colonne Gauche : 2 Articles en Pleine Largeur Éditoriale (7 colonnes) -->
      <div class="lg:col-span-7 space-y-8">
        {journalPosts.slice(0, 2).map(post => (
          <article class="border-b border-stone-200 pb-8">
            <span class="text-xs font-mono font-semibold uppercase tracking-wider text-amber-800">
              {post.data.category} • {new Date(post.data.pubDate).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}
            </span>
            <h3 class="text-xl sm:text-2xl font-serif font-bold text-stone-900 hover:text-amber-800 transition-colors mt-2 mb-3 leading-tight">
              <a href={`/blog/${post.id}/`}>
                {post.data.title}
              </a>
            </h3>
            <p class="text-sm text-stone-600 leading-relaxed mb-4">
              {post.data.description}
            </p>
            <a href={`/blog/${post.id}/`} class="text-xs font-mono font-bold uppercase tracking-wider text-stone-900 hover:text-amber-800 inline-flex items-center gap-1.5">
              Explorer cette étape &rarr;
            </a>
          </article>
        ))}
      </div>

      <!-- Colonne Droite : Fil Chronologique Compact (5 colonnes) -->
      <div class="lg:col-span-5 bg-white border border-stone-200 p-6 rounded-lg shadow-sm">
        <h3 class="text-xs font-mono font-bold uppercase tracking-widest text-stone-900 border-b border-stone-200 pb-3 mb-5">
          Dernières Parutions
        </h3>

        <div class="divide-y divide-stone-100">
          {journalPosts.slice(2, 7).map(post => (
            <article class="py-3.5 first:pt-0 last:pb-0">
              <span class="text-[10px] font-mono text-stone-400 block mb-1">
                {new Date(post.data.pubDate).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' })} • {post.data.category}
              </span>
              <h4 class="text-sm font-semibold text-stone-900 hover:text-amber-800 transition-colors line-clamp-2 leading-snug">
                <a href={`/blog/${post.id}/`}>
                  {post.data.title}
                </a>
              </h4>
            </article>
          ))}
        </div>
      </div>

    </div>

    <!-- Bannière In-Content Publicité (Revive) -->
    {siteConfig.revive?.zones?.inContent && (
      <div class="my-10 flex justify-center">
        <ReviveSlot format={siteConfig.revive.zones.inContent.format} zoneId={siteConfig.revive.zones.inContent.zoneId} />
      </div>
    )}

    <!-- Appel à l'Action Global -->
    <div class="mt-12 text-center py-10 bg-[#faf8f5] border border-stone-300 rounded-lg">
      <h3 class="text-xl sm:text-2xl font-serif font-bold text-stone-950 mb-2">
        Prêt à tracer votre itinéraire en Martinique ?
      </h3>
      <p class="text-stone-600 text-sm max-w-xl mx-auto mb-6">
        Accédez librement aux 200 guides de route, fiches d'excursions, plages et sentiers volcaniques.
      </p>
      <a href="/blog/" class="inline-flex items-center gap-2 px-6 py-3 bg-stone-900 hover:bg-amber-800 text-white font-mono text-xs font-bold uppercase tracking-wider rounded transition-colors">
        Consulter l'Ensemble des 200 Guides &rarr;
      </a>
    </div>
  </section>
</Layout>
